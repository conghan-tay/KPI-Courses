# Public edge API
# Local defaults are convenient for development. Production startup rejects them.
API_KEY=local-api-key
GATEWAY_PORT=8080

# Postgres. The courses/lessons/users tables from POC_UserJourney.md §1; the
# gateway owns the schema and applies migrations at boot.
DATABASE_URL=postgres://courses:courses@postgres:5432/courses?sslmode=disable

# The web app is a BFF in front of the gateway: it turns uploads into text, adds
# credentials, and proxies. API_BASE_URL is server-side only on purpose.
API_BASE_URL=http://gateway:8080
GATEWAY_API_KEY=local-api-key

# Temporal. The local stack runs a dev server; production points at a real cluster or
# Temporal Cloud (set TEMPORAL_API_KEY and TEMPORAL_TLS=true).
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=course-ingest
TEMPORAL_API_KEY=
TEMPORAL_TLS=false

# Ingestion model. `fake` replays docs/productDocs/fixtures/expected.json — no key,
# deterministic, and what CI and the e2e stack run.
# POC_UserJourney.md §0: bigger and slower is fine for ingestion.
MODEL_PROVIDER=anthropic
MODEL_NAME=claude-opus-5
# MODEL_TEMPERATURE=0.2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# LangSmith is optional. Set LANGSMITH_TRACING=true to enable it.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kpi-courses

# Infrastructure
REDIS_URL=redis://redis:6379/0
# Retained for Journey 3's tutor. The gateway writes knowledge over HTTP; nothing
# reads it back yet.
CHROMA_URL=http://chroma:8000
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_COLLECTION=course_knowledge
EMBEDDING_MODEL=text-embedding-3-small

# Ingestion controls
# How long a whole ingestion run may take before Temporal closes it and the draft
# becomes retryable. Owned by the gateway: workflow code cannot read the
# environment, so it travels as a StartWorkflowOptions field.
INGEST_TIMEOUT_MINUTES=20
# Above this a corpus is a paste bomb, not a course.
MAX_SOURCE_CHARS=400000
# POC_UserJourney.md: 5–9 lessons. Fixture assertion A7: 5–8 positions.
MAX_LESSONS=9
MAX_POSITIONS=8
RATE_LIMIT_PER_MINUTE=60
