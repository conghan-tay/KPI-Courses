# Ingestion mode.
#   mock  replays docs/productDocs/fixtures/expected.json with a staged status
#         stream. No API key, deterministic, and what CI runs.
#   live  makes the real single-LLM ingestion call.
INGEST_MODE=mock

# Pacing for the mock status stream. 0 makes tests instant.
INGEST_MOCK_DELAY_MS=700

# Set to 1 to force ingestion to fail, for exercising the retry state.
# INGEST_FORCE_ERROR=1

# Live mode only. Same convention as the Python worker in this repo.
MODEL_PROVIDER=anthropic
MODEL_NAME=claude-opus-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
INGEST_TIMEOUT_MS=180000

# Where the JSON course store is written. Defaults to ./.data
# DATA_DIR=

# Where docs/productDocs/fixtures was copied to. Defaults to ../../docs/productDocs/fixtures
# FIXTURE_DIR=

# Point the browser at a different API host — this is the seam for swapping in
# the Go gateway once it serves /api/courses/*. Empty means same-origin.
NEXT_PUBLIC_API_BASE=
