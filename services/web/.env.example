# The Go API this app proxies to. Server-side only, deliberately: a NEXT_PUBLIC_
# variable is baked into the client bundle, and the gateway is not meant to be
# reachable from a browser.
API_BASE_URL=http://localhost:8080

# Must match API_KEY on the gateway.
GATEWAY_API_KEY=local-api-key

# Where docs/productDocs/fixtures was copied to. Test-only — the fixture is
# replayed by the Python worker, not by this app.
# Defaults to ../../docs/productDocs/fixtures
# FIXTURE_DIR=

# Where the Playwright smoke points. Defaults to http://localhost:3000, which is
# the web service in compose.yaml.
# E2E_BASE_URL=
